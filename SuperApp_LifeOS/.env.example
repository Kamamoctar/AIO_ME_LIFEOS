# Mode local (utilise par defaut et par Docker Compose)
DATABASE_URL="file:./prisma/dev.db"

# Optionnel : seulement pour une future base Turso distante
# TURSO_DATABASE_URL="libsql://lifeos-example.turso.io"
# TURSO_AUTH_TOKEN="replace-with-your-turso-token"

# Optionnel : authentification distante. Sans ces cles, le mode local est actif.
